#!name=Bili CDN Auto
#!desc=B站视频 CDN 自动实测、缓存与故障切换；使用本机控制 URL 配合快捷指令。

[rewrite_local]
^http:\/\/bili-cdn-auto\.invalid\/ url script-request-header __BASE_URL__/scripts/control-http.js
^https?:\/\/(?:[^\/]*\.bilivideo\.com(?::\d+)?|[^\/]*\.mcdn\.bilivideo\.cn(?::\d+)?|[^\/]*\.akamaized\.net(?::\d+)?|[^\/]+:4480)\/upgcxcode\/ url script-request-header __BASE_URL__/scripts/request.js
^https?:\/\/(?:[^\/]*\.bilivideo\.com(?::\d+)?|[^\/]*\.mcdn\.bilivideo\.cn(?::\d+)?|[^\/]*\.akamaized\.net(?::\d+)?|[^\/]+:4480)\/upgcxcode\/ url script-response-header __BASE_URL__/scripts/response.js

[mitm]
hostname = *.mcdn.bilivideo.cn, upos-sz-mirror*.bilivideo.com, cn-hk-eq-*.bilivideo.com, upos-*-mirrorakam.akamaized.net
