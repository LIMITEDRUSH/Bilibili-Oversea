name: "Bili CDN Auto"
desc: "B站视频 CDN 无阻塞开播、自适应复核与故障切换；支持快捷指令本机控制。"
author: "Bili CDN Auto contributors"
version: "0.3.4"

http:
  force-http-engine:
    - "*.bilivideo.com:80"
    - "upos-*-mirrorakam.akamaized.net:80"
    - "*:4480"
    - "*:9102"
  mitm:
    - "*.mcdn.bilivideo.cn"
    - "*.mcdn.bilivideo.cn:4483"
    - "upos-sz-mirror*.bilivideo.com"
    - "upos-sz-mirror*.bilivideo.com:4483"
    - "cn-hk-eq-*.bilivideo.com"
    - "upos-*-mirrorakam.akamaized.net"
  script:
    - name: "Bili CDN Auto · Local Control"
      match: ^http:\/\/bili-cdn-auto\.invalid\/
      type: request
    - name: "Bili CDN Auto · Request"
      match: ^https?:\/\/(?:[^\/]*\.bilivideo\.com(?::\d+)?|[^\/]*\.mcdn\.bilivideo\.cn(?::\d+)?|[^\/]*\.akamaized\.net(?::\d+)?|[^\/]+:4480)\/upgcxcode\/
      type: request
      timeout: 12
      argument: "candidates=upos-sz-mirroraliov.bilivideo.com|upos-sz-mirrorcosov.bilivideo.com|upos-sz-mirrorhwov.bilivideo.com&success_ttl=10800&failure_ttl=600&verify_interval=900&verify_delay=15&quick_probe_bytes=131072&verify_probe_bytes=131072&quick_probe_timeout=4&switch_gain=120&fallback=original"
    - name: "Bili CDN Auto · Response"
      match: ^https?:\/\/(?:[^\/]*\.bilivideo\.com(?::\d+)?|[^\/]*\.mcdn\.bilivideo\.cn(?::\d+)?|[^\/]*\.akamaized\.net(?::\d+)?|[^\/]+:4480)\/upgcxcode\/
      type: response
      timeout: 5
      argument: "failure_threshold=2&failure_ttl=600&success_ttl=10800"

script-providers:
  "Bili CDN Auto · Local Control":
    url: https://raw.githubusercontent.com/LIMITEDRUSH/Bilibili-Oversea/main/scripts/control-http.js
    interval: 86400
  "Bili CDN Auto · Request":
    url: https://raw.githubusercontent.com/LIMITEDRUSH/Bilibili-Oversea/main/scripts/request.js
    interval: 86400
  "Bili CDN Auto · Response":
    url: https://raw.githubusercontent.com/LIMITEDRUSH/Bilibili-Oversea/main/scripts/response.js
    interval: 86400
